<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <CheckForWorkloadUpdates>false</CheckForWorkloadUpdates>
  </PropertyGroup>
  <PropertyGroup>
    <CheckForWorkloadUpdates>false</CheckForWorkloadUpdates>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="favicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="favicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="NAudio.Asio" />
    <PackageReference Include="NAudio.Core" />
    <PackageReference Include="NAudio.Midi" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="NAudio.WinForms" />
    <PackageReference Include="NAudio.WinMM" />
    <PackageReference Include="System.Security.AccessControl" />
    <PackageReference Include="System.Security.Principal.Windows" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="favicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="UI\Form1.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>
</Project>
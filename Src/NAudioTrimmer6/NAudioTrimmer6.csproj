<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <CheckForWorkloadUpdates>false</CheckForWorkloadUpdates>
  </PropertyGroup>
  <PropertyGroup>
    <CheckForWorkloadUpdates>false</CheckForWorkloadUpdates>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="favicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="favicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="NAudio.Asio" Version="3.0.1" />
    <PackageReference Include="NAudio.Core" Version="3.0.1" />
    <PackageReference Include="NAudio.Midi" Version="3.0.1" />
    <PackageReference Include="NAudio.Wasapi" Version="22.0.0" />
    <PackageReference Include="NAudio.WinForms" Version="3.0.1" />
    <PackageReference Include="NAudio.WinMM" Version="3.0.1" />
    <PackageReference Include="System.Security.AccessControl" Version="6.0.1" />
    <PackageReference Include="System.Security.Principal.Windows" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="favicon.ico" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="UI\Form1.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>
</Project>